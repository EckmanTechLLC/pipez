ANTHROPIC_API_KEY=
PIPEZ_MODEL_DEEP=claude-opus-5-5
PIPEZ_EFFORT_DEEP=high
PIPEZ_MODEL_STANDARD=claude-sonnet-5-5
PIPEZ_EFFORT_STANDARD=medium
PIPEZ_MODEL_LIGHT=claude-haiku-5-5
PIPEZ_EFFORT_LIGHT=low
PIPEZ_MAX_TOKENS=128000
PIPEZ_TASK_RETRIES=3
PIPEZ_RETRY_DELAY=20
PIPEZ_FALLBACKS=1
PIPEZ_MOCK=0
PIPEZ_SEARCH=1
PIPEZ_SEARCH_MAX_USES=5
PIPEZ_MAX_DEPTH=4
PIPEZ_MAX_CHILDREN=8
PIPEZ_MAX_TASKS=100
PIPEZ_CONCURRENCY=4
PIPEZ_ARTIFACTS=1
PIPEZ_DB=./pipez.sqlite3
PIPEZ_ARTIFACTS_DIR=./artifacts
PIPEZ_HOST=127.0.0.1
PIPEZ_PORT=8400
PIPEZ_ESCALATE=1
# PIPEZ_LOCAL_BASE_URL=
# PIPEZ_LOCAL_MODEL=
PIPEZ_LOCAL_API_KEY=
PIPEZ_LOCAL_TIMEOUT=600
PIPEZ_LOCAL_TEMPERATURE=0.2
# Per-call output cap for the local tier (default 16000); timeouts/truncations are not retried
PIPEZ_LOCAL_MAX_TOKENS=16000
PIPEZ_LOCAL_THINKING=0
PIPEZ_LOCAL_STAGES=
# Coder tier only: gpt-oss-style reasoning_effort (low|medium|high), empty = not sent
PIPEZ_LOCAL_REASONING_EFFORT=
# Second local tier `local_reason` (reasoner, e.g. gpt-oss-120b); exists only when the URL is set.
# Key/timeout/temperature fall back to the PIPEZ_LOCAL_* values when empty.
# PIPEZ_LOCAL_REASON_BASE_URL=
# PIPEZ_LOCAL_REASON_MODEL=
# PIPEZ_LOCAL_REASON_API_KEY=
# PIPEZ_LOCAL_REASON_TIMEOUT=
# PIPEZ_LOCAL_REASON_TEMPERATURE=
# Falls back to PIPEZ_LOCAL_MAX_TOKENS when empty
# PIPEZ_LOCAL_REASON_MAX_TOKENS=
# PIPEZ_LOCAL_REASON_THINKING=0
# PIPEZ_LOCAL_REASON_REASONING_EFFORT=
# PIPEZ_LOCAL_REASON_STAGES=
# Structured-output mode per local tier: json_schema (strict grammar), json_object, or prompt
# (schema pasted into the prompt, no response_format). Defaults: local=json_schema,
# local_reason=json_object (gpt-oss degenerates under llama.cpp's schema grammar).
# PIPEZ_LOCAL_STRUCTURED=json_schema
# PIPEZ_LOCAL_REASON_STRUCTURED=json_object
PIPEZ_SANDBOX=pve
PIPEZ_SANDBOX_BOOT_TIMEOUT=240
PIPEZ_DEPLOY_BOOT_TIMEOUT=600
PIPEZ_DEPLOY_READY_TIMEOUT=600
PIPEZ_SSH_KEY=~/.ssh/pipez_ed25519
PIPEZ_SANDBOX_KEEP_ON_FAILURE=1
PIPEZ_PVE_URL=
PIPEZ_PVE_TOKEN_ID=
PIPEZ_PVE_TOKEN_SECRET=
PIPEZ_PVE_NODE=
PIPEZ_PVE_POOL=pipez
PIPEZ_PVE_TEMPLATE=9001
PIPEZ_PVE_VMID_RANGE=9100-9199
PIPEZ_PVE_VERIFY_TLS=1
# 9002 = pipez-app-base: guest agent preinstalled, so deploy VMs get an IP in seconds (infra/pve/make-app-template.sh)
PIPEZ_PVE_DEPLOY_TEMPLATE=9002
PIPEZ_PVE_DEPLOY_VMID_RANGE=9200-9299
PIPEZ_DEPLOY_AUTO=1
PIPEZ_DEPLOY_HEALTH_TIMEOUT=180
# Hours until a ready deployment is auto-undeployed unless kept (0 = never)
PIPEZ_DEPLOY_TTL_HOURS=72
# Seconds between expiry passes
PIPEZ_DEPLOY_SWEEP_SECONDS=3600
# 1 = a newly ready deployment undeploys its project's other ready, non-kept ones
PIPEZ_DEPLOY_REPLACE=1
# Tier of the intake discovery call (deep, standard, light); default deep
PIPEZ_INTAKE_TIER=deep
# Plan effort (default high); revision rounds can use a cheaper tier/effort.
# PIPEZ_PLAN_EFFORT=high
# PIPEZ_PLAN_REVISION_TIER=deep
# PIPEZ_PLAN_REVISION_EFFORT=high
# Mechanical plan gate (no LLM): off | warn (violations -> plan warnings) | revise (errors are
# sent back to the planner for up to PIPEZ_PLAN_GATE_ROUNDS rounds). Never fails a run.
# Checks: module_dep_unknown, task_module_unknown (every task owns one module), dep_coverage
# (task depends on a task of each dependency module, or names its interface), contract_interface,
# contract_files, consumer_names_interface, task_prompt_thin (< MIN_PROMPT_CHARS or names no
# contract symbol), acceptance_not_checkable, manual_testing_only (+ deployment/process heuristics).
# PIPEZ_PLAN_GATE=warn
# PIPEZ_PLAN_GATE_ROUNDS=3
# PIPEZ_PLAN_GATE_MIN_PROMPT_CHARS=400
# TEST HOOK, never set in normal use: in review round 1 force the first verdict whose claim
# contains this substring (case-insensitive) to `wrong`, to exercise the fixer/redeploy round.
# PIPEZ_REVIEW_INJECT_WRONG=
